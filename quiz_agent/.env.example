# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5433/quiz_db

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: 'ollama' (default, local) | 'bedrock' (AWS, optional fallback)
LLM_PROVIDER=ollama

# ── Ollama (Local LLM — Primary Provider) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# ── LLM Parameters ────────────────────────────────────────────────────────────
TEMPERATURE=0.3
MAX_TOKENS=2048

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AWS Bedrock (Optional Fallback — only needed if LLM_PROVIDER=bedrock) ─────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
